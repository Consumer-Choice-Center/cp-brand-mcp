{
  "name": "cp-brand-mcp",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Considerate Pouchers MCP: one-pagers, social posts, request-supplied portrait quotes and real-photo cutouts in English and Swedish.",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "check": "node --check src/server.mjs && node --check src/brand.mjs && node --check src/social.mjs && node --check src/cutout.mjs && node --check src/scene.mjs && node --check src/mask.mjs && node --check src/grain.mjs && node --check src/visual-qa.mjs && node --check src/mcp-factory.mjs && node --check src/http-server.mjs && node --check src/http-artifacts.mjs && node --check src/remote-quote.mjs && node --check src/quote-worker.mjs && node --check src/portrait-source.mjs",
    "test:portable": "node --test tests/portable.test.mjs",
    "audit:prod": "pnpm audit --prod",
    "start:http": "node src/http-server.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "test:http": "node --test tests/http*.test.mjs tests/portrait-source.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "dictionary-sv": "4.0.0",
    "fontkit": "2.0.4",
    "nspell": "2.1.5",
    "zod": "4.6.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.1.0"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Consumer-Choice-Center/cp-brand-mcp.git"
  },
  "license": "UNLICENSED",
  "bin": {
    "cp-brand-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "data/brand.json",
    "data/fonts.example.json",
    "assets/logos",
    "assets/images",
    "assets/references",
    "assets/manifest.json",
    "examples",
    "scripts/smoke-test.mjs",
    "scripts/audit-assets.mjs",
    "README.md",
    "DEPLOYMENT.md",
    "LICENSE",
    "pnpm-workspace.yaml",
    "deploy",
    "scripts/smoke-http.mjs",
    "assets/fonts",
    "docs"
  ]
}
