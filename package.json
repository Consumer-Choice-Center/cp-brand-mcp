{
  "name": "cp-brand-mcp",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Considerate Pouchers one-pager MCP: contextual visuals, CP branding and strict local validation.",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "check": "node --check src/server.mjs && node --check src/brand.mjs",
    "test:portable": "node --test tests/portable.test.mjs",
    "audit:prod": "pnpm audit --prod"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xmldom/xmldom": "0.9.12",
    "fontkit": "2.0.4",
    "zod": "3.25.76"
  },
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Consumer-Choice-Center/cp-brand-mcp.git"
  },
  "license": "UNLICENSED",
  "bin": {
    "cp-brand-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "data/brand.json",
    "data/fonts.example.json",
    "assets/logos",
    "assets/images",
    "assets/references",
    "assets/manifest.json",
    "examples",
    "scripts/smoke-test.mjs",
    "scripts/audit-assets.mjs",
    "README.md",
    "DEPLOYMENT.md",
    "LICENSE"
  ]
}
